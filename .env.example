# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/recourse_db

# ── File uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/uploads
MAX_FILE_SIZE_MB=10
MAX_MANUAL_CHARS=50000

# ── Optional S3-compatible object storage (leave empty to use LocalFileStorage)
S3_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Optional LLM advisory for evidence verification ───────────────────────────
LLM_API_KEY=
LLM_MODEL=

# ── NLP model names ───────────────────────────────────────────────────────────
SBERT_MODEL=all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm
